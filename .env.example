# Supabase project credentials (Settings -> API in your Supabase dashboard)
# Free tier is sufficient for development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Groq API key (console.groq.com -> API Keys). Free tier is sufficient for
# development. Server-only: do NOT prefix this with VITE_, or Vite will
# bundle it into client-side JS and leak it to every visitor.
GROQ_API_KEY=your-groq-api-key
